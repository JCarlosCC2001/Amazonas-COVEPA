      <name>AM-0237 - NUEVO PORVENIR (AM-0237-A01)</name>
      <Snippet maxLines="0"></Snippet>
      <styleUrl>#pin_amarillo</styleUrl>
      <description><![CDATA[<div style="width:850px;min-width:850px;font-family:Arial,sans-serif;background:#ffffff;color:#111827;padding:8px;line-height:1.4;">
<h3 style="margin:0 0 4px;font-size:15px;color:#111827;border-bottom:1px solid #e5e7eb;padding-bottom:4px;">AM-0237 - NUEVO PORVENIR (AM-0237-A01)</h3>
<div style="font-size:12px;color:#4b5563;margin-bottom:8px;">Localidad: <b>NUEVO PORVENIR</b> &nbsp;|&nbsp; Distrito: <b>JAMALCA</b> &nbsp;|&nbsp; Provincia: <b>UTCUBAMBA</b> &nbsp;|&nbsp; <b>GRUPO 1</b> (ZONA 7)</div>

    <table border="1" cellpadding="6" cellspacing="0" width="850" style="border-collapse:collapse;width:850px;min-width:850px;font-size:11px;font-family:Arial,sans-serif;background:#ffffff;border-color:#d1d5db;margin-top:6px;">
      <thead>
        <tr bgcolor="#f3f4f6" style="font-weight:bold;color:#111827;">
          <th width="120" style="width:120px;padding:6px 8px;border:1px solid #d1d5db;white-space:nowrap;">Código de observación</th>
          <th width="240" style="width:240px;padding:6px 8px;border:1px solid #d1d5db;">Detalle</th>
          <th width="230" style="width:230px;padding:6px 8px;border:1px solid #d1d5db;">Comentario inicial</th>
          <th width="200" style="width:200px;padding:6px 8px;border:1px solid #d1d5db;">Acuerdo de subsanación</th>
          <th width="60" style="width:60px;padding:6px 8px;border:1px solid #d1d5db;text-align:center;">Estado</th>
        </tr>
      </thead>
      <tbody>
        <tr><td><b>C-3359</b></td><td>—</td><td>ITM de 16 A. no corresponde</td><td>FOTOGRAFIA DE SUBSANACION</td><td align="center" style="font-weight:bold;color:#d97706;">Pendiente</td></tr><tr bgcolor="#f9fafb"><td><b>C-3353</b></td><td>—</td><td>luminarias sin funcionamiento (diferencial apagado)</td><td>Informe de Subsanacion</td><td align="center" style="font-weight:bold;color:#d97706;">Pendiente</td></tr><tr><td><b>C-3354</b></td><td>—</td><td>Se encontró descargado</td><td>Fotografia de instalación de Luz de emergencia + Video de prueba de autonomia + Planos As Built</td><td align="center" style="font-weight:bold;color:#d97706;">Pendiente</td></tr><tr bgcolor="#f9fafb"><td><b>C-3355</b></td><td>—</td><td>No presentaron planos</td><td>FOTO DE UBICACION DE POZOS + PLANO ASBUILT</td><td align="center" style="font-weight:bold;color:#d97706;">Pendiente</td></tr><tr><td><b>C-3356</b></td><td>—</td><td>Tiene cintillo bandara pero no etiqueta</td><td>FOTOS DE ETIQUETADO (ORIGEN - DESTINO) + PLANO ASBUILT</td><td align="center" style="font-weight:bold;color:#d97706;">Pendiente</td></tr><tr bgcolor="#f9fafb"><td><b>C-3357</b></td><td>—</td><td>Tiene cintillo bandara pero no etiqueta</td><td>Informe de Subsanacion</td><td align="center" style="font-weight:bold;color:#d97706;">Pendiente</td></tr><tr><td><b>H1-OC-50-2280</b></td><td>—</td><td>tuberia de drenaje, actualizar planos asbuilt</td><td>FOTOGRAFIAS + PLANOS ASBUILT</td><td align="center" style="font-weight:bold;color:#d97706;">Pendiente</td></tr><tr bgcolor="#f9fafb"><td><b>H1-OC-50-2281</b></td><td>—</td><td>concertinas - alambre liso de 3 hilos falta tensar</td><td>FOTOGRAFIA DE LA SUBSANACIÓN</td><td align="center" style="font-weight:bold;color:#d97706;">Pendiente</td></tr><tr><td><b>H1-OC-50-2282</b></td><td>—</td><td>puerta metalica - falta acabado final</td><td>FOTOS</td><td align="center" style="font-weight:bold;color:#d97706;">Pendiente</td></tr><tr bgcolor="#f9fafb"><td><b>H1-OC-50-2283</b></td><td>—</t