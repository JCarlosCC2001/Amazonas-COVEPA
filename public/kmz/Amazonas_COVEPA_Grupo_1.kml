      <description><![CDATA[<div style="width:850px;min-width:850px;font-family:Arial,sans-serif;background:#ffffff;color:#111827;padding:8px;line-height:1.4;">
<h3 style="margin:0 0 4px;font-size:15px;color:#111827;border-bottom:1px solid #e5e7eb;padding-bottom:4px;">AM-0231 - SALAO (AM-0231-A01)</h3>
<div style="font-size:12px;color:#4b5563;margin-bottom:8px;">Localidad: <b>SALAO</b> &nbsp;|&nbsp; Distrito: <b>JAMALCA</b> &nbsp;|&nbsp; Provincia: <b>UTCUBAMBA</b> &nbsp;|&nbsp; <b>GRUPO 1</b> (ZONA 7)</div>

    <table border="1" cellpadding="6" cellspacing="0" width="850" style="border-collapse:collapse;width:850px;min-width:850px;font-size:11px;font-family:Arial,sans-serif;background:#ffffff;border-color:#d1d5db;margin-top:6px;">
      <thead>
        <tr bgcolor="#f3f4f6" style="font-weight:bold;color:#111827;">
          <th width="120" style="width:120px;padding:6px 8px;border:1px solid #d1d5db;white-space:nowrap;">Código de observación</th>
          <th width="240" style="width:240px;padding:6px 8px;border:1px solid #d1d5db;">Detalle</th>
          <th width="230" style="width:230px;padding:6px 8px;border:1px solid #d1d5db;">Comentario inicial</th>
          <th width="200" style="width:200px;padding:6px 8px;border:1px solid #d1d5db;">Acuerdo de subsanación</th>
          <th width="60" style="width:60px;padding:6px 8px;border:1px solid #d1d5db;text-align:center;">Estado</th>
        </tr>
      </thead>
      <tbody>
        <tr><td><b>H1-OC-50-2235</b></td><td>—</td><td>corregir acabado del tarrajeo exterior (no es uniforme)</td><td>FOTOS DE LA SUBSANACIÓN</td><td align="center" style="font-weight:bold;color:#d97706;">Pendiente</td></tr><tr bgcolor="#f9fafb"><td><b>H1-OC-50-2236</b></td><td>—</td><td>corregir acabado del tarrajeo interior (no es uniforme)</td><td>FOTOS DE LA SUBSANACIÓN</td><td align="center" style="font-weight:bold;color:#d97706;">Pendiente</td></tr><tr><td><b>H1-OC-50-2237</b></td><td>—</td><td>mejorar pintura de ladrillo</td><td>FOTOS DE LA SUBSANACIÓN</td><td align="center" style="font-weight:bold;color:#d97706;">Pendiente</td></tr><tr bgcolor="#f9fafb"><td><b>H1-OC-50-2238</b></td><td>—</td><td>mejorar pintura en columnas y vigas</td><td>FOTOS DE LA SUBSANACIÓN</td><td align="center" style="font-weight:bold;color:#d97706;">Pendiente</td></tr><tr><td><b>H1-OC-50-2239</b></td><td>—</td><td>falta amarrar concertina</td><td>FOTOGRAFIA DE LA SUBSANACIÓN</td><td align="center" style="font-weight:bold;color:#d97706;">Pendiente</td></tr><tr bgcolor="#f9fafb"><td><b>H1-OC-50-2241</b></td><td>—</td><td>marco de puerta no esta instalado a nivel de losa (presenta luz)</td><td>FOTOS</td><td align="center" style="font-weight:bold;color:#d97706;">Pendiente</td></tr><tr><td><b>H1-OC-50-2242</b></td><td>—</td><td>falta tirador interno</td><td>FOTOS</td><td align="center" style="font-weight:bold;color:#d97706;">Pendiente</td></tr><tr bgcolor="#f9fafb"><td><b>H1-OC-50-2244</b></td><td>—</td><td>pintura no es uniforme (mal acabado, presencia de grumos)</td><td>FOTOS</td><td align="center" style="font-weight:bold;color:#d97706;">Pendiente</td></tr><tr><td><b>H1-OC-50-2246</b></td><td>—</td><td>falta nivelar terreno</td><td>FOTOS DE NIVELACIÓN + PLANOS ASBUILT</td><td align="center" style="font-weight:bold;color:#d97706;">Pendiente</td></tr><tr bgcolor="#f9fafb"><td><b>H1-OC-50-2247</b></td><td>—</td><td>espesor de ripio menor a 10cm / falta nivelar ripio</td><td>FOTOS DE NIVELACIÓN + PLANOS ASBUILT</td><td align="center" style="font-weight:bold;color:#d97706;">Pendiente</td></tr><tr><td><b>H1-OC-50-2248</b></td><td>—</td><td>presenta quiñes en sus bordes internos y externos y limpieza de losa</td><td>FOTOGRAFÍAS DE SUBSANACIÓN</td><td align="center" style="font-weight:bold;color:#d97706;">Pendiente</td></tr><tr bgcolor="#f9fafb"><td><b>H1-OC-50-2249</b></td><td>—</td><td>falta acabado semipulido</td><td>FOTOGRAFÍAS DE SUBSANACIÓN</td><td align="center" style="font-weight:bold;color:#d97706;">Pendiente</td></tr><tr><td><b>H1-OC-50-2251</b></td><td>—</td><td>falta acabado semilupido</td><td>FOTOGRAFÍAS DE SUBSANACIÓN</td><td align="center" style="font-weight:bold;color:#d97706;">Pendiente</td></tr><tr bgcolor="#f9fafb"><td><b>H1-OC-50-2252</b></td><td>—</td><td>dados desnivelados</td><td>INFORME FOTOGRÁFICO DE SUBSANACIÓN</td><td align="center" style="font-weight:bold;color:#d97706;">Pendiente</td></tr><tr><td><b>H1-OC-50-2253</b></td><td>—</td><td>falta instalar accesorios de soporte de escalerillas</td><td>CERTIFICADO DE GALVANIZADO + FICHA TECNICA + FOTOGRAFÍAS DE SUBSANACIÓN</td><td align="center" style="font-weight:bold;color:#d97706;">Pendiente</td></tr><tr bgcolor="#f9fafb"><td><b>H1-OC-50-2254</b></td><td>—</td><td>mejorar acabado de tarrajeo en pedestales</td><td>INFORME FOTOGRÁFICO+PLANOS AS BUILT</td><td align="center" style="font-weight:bold;color:#d97706;">Pendiente</td></tr><tr><td><b>H1-OC-50-2255</b></td><td>—</td><td>no hay resistencia a ser retirado / material de relleno suelto</td><td>INFORME FOTOGRÁFICO+PLANOS AS BUILT</td><td align="center" style="font-weight:bold;color:#d97706;">Pendiente</td></tr><tr bgcolor="#f9fafb"><td><b>H1-OC-50-2257</b></td><td>—</td><td>sustentar bajada de soportes fuera y dentro de torre</td><td>SUSTENTO DE BAJADA DE SOPORTES FUERA Y DENTRO DE TORRE</td><td align="center" style="font-weight:bold;color:#d97706;">Pendiente</td></tr><tr><td><b>H1-OC-50-2258</b></td><td>—</td><td>aisladores instalados no estan acorde a plano ie05</td><td>FOTOGRAFÍAS + PLANOS ASBUILT</td><td align="center" style="font-weight:bold;color:#d97706;">Pendiente</td></tr><tr bgcolor="#f9fafb"><td><b>H1-OC-50-2259</b></td><td>—</td><td>pernos no cuentan con 3 hilos libres según norma</td><td>INFORME FOTOGRÁFICO+PLANOS AS BUILT</td><td align="center" style="font-weight:bold;color:#d97706;">Pendiente</td></tr><tr><td><b>H1-OC-50-2261</b></td><td>—</td><td>falta acabado semipulido</td><td>FOTOGRAFÍAS DE LA SUBSANACIÓN</td><td align="center" style="font-weight:bold;color:#d97706;">Pendiente</td></tr><tr bgcolor="#f9fafb"><td><b>H1-OC-50-2262</b></td><td>—</td><td>losa desnivelada</td><td>FOTOGRAFÍAS DE LA SUBSANACIÓN</td><td align="center" style="font-weight:bold;color:#d97706;">Pendiente</td></tr><tr><td><b>H1-OC-50-2275</b></td><td>—</td><td>perneria utilizada no acorde a planos</td><td>FOTOGRAFÍAS DE LA SUBSANACIÓN</td><td align="center" style="font-weight:bold;color:#d97706;">Pendiente</td></tr><tr bgcolor="#f9fafb"><td><b>H1-SH-50-89</b></td><td>Conforme a planos de diseño</td><td>SE LE ANCLADO UNA BARRA DE ATERRAMIENTOS EN LA PARTE EXTERNA DEL SHELTER QUE NO ESTA ACORDE A PLANO</td><td>Informe de Subsanacion</td><td align="center" style="font-weight:bold;color:#d97706;">Pendiente</td></tr><tr><td><b>H1-SH-50-90</b></td><td>Dimensiones y estructura del shelter según planos de diseño</td><td>PRESENTA DEFORMACIONES EN PLANCHA ACANALADA (PARTE POSTERIOR INTERNA).</td><td>Informe de Subsanacion</td><td align="center" style="font-weight:bold;color:#d97706;">Pendiente</td></tr><tr bgcolor="#f9fafb"><td><b>H1-SH-50-92</b></td><td>El gabinete deberá contar con su propia barra de aterramiento 
que permita la conexión como mínimo de 6 conexiones de 
entrada de 5/16 y uno de salida de 3/8”</td><td>FALTA COLOCAR BARRA</td><td>FOTOS Y VIDEO DE CONTINUIDAD DE ATERRAMIENTO</td><td align="center" style="font-weight:bold;color:#d97706;">Pendiente</td></tr><tr><td><b>H1-SH-50-94</b></td><td>Todos los accesos de cable deberán estar en la parte inferior y 
deberán permitir el adecuado ingreso de cables y su respectivo 
sellamiento. Deberá contar con alarma de puerta abierta de tipo 
fin de carrera.</td><td>FALTA COMPLETAR BASE METALICA PARTE INFERIOR.</td><td>FOTOGRAFIA DE SUBSANACIÓN</td><td align="center" style="font-weight:bold;color:#d97706;">Pendiente</td></tr><tr bgcolor="#f9fafb"><td><b>B-1163</b></td><td>—</td><td>Cable UTP no especifica si es libre de halógeno</td><td>FOTOS DE INSTALACION DE CABLE DE GESTION HOMOLOGADO / FOTO ESPECIFICACION DE LIBRE DE HALOGENOS</td><td align="center" style="font-weight:bold;color:#d97706;">Pendiente</td></tr><tr><td><b>B-1164</b></td><td>—</td><td>Cable UTP no especifica si es libre de halógeno</td><td>FOTOS DE INSTALACION DE CABLE DE GESTION HOMOLOGADO / FOTO ESPECIFICACION DE LIBRE DE HALOGENOS</td><td align="center" style="font-weight:bold;color:#d97706;">Pendiente</td></tr><tr bgcolor="#f9fafb"><td><b>B-1201</b></td><td>—</td><td>Conexión en SPAT de arriba hacia abajo en conector AB</td><td>FOTOGRAFIAS DE SUBSANACION.</td><td align="center" style="font-weight:bold;color:#d97706;">Pendiente</td></tr><tr><td><b>B-1174</b></td><td>—</td><td>Aterramiento del router no cuenta con etiquetado</td><td>Informe de Subsanacion</td><td align="center" style="font-weight:bold;color:#d97706;">Pendiente</td></tr><tr bgcolor="#f9fafb"><td><b>B-1190</b></td><td>—</td><td>Luminaria interna inoperativa, instalación incompleta</td><td>VIDEO DE OPERATIVIDAD DE LUMINARIA INTERNA DE SHELTER</td><td align="center" style="font-weight:bold;color:#d97706;">Pendiente</td></tr><tr><td><b>B-1196</b></td><td>—</td><td>Cables de tierra no identificado en registro de pozo</td><td>FOTOGRAFIAS DE SUBSANACION Y PLANOS ASBUILT</td><td align="center" style="font-weight:bold;color:#d97706;">Pendiente</td></tr><tr bgcolor="#f9fafb"><td><b>B-1198</b></td><td>—</td><td>Cables no identificados en barra equipotencial</td><td>FOTOGRAFIAS DE SUBSANACION Y PLANOS ASBUILT</td><td align="center" style="font-weight:bold;color:#d97706;">Pendiente</td></tr><tr><td><b>B-1189</b></td><td>—</td><td>Pruebas no realizadas por no tener gestión del nodo</td><td>Se presentara capturas desde Gestor desde el NOC</td><td align="center" style="font-weight:bold;color:#d97706;">Pendiente</td></tr><tr bgcolor="#f9fafb"><td><b>OCI-1326</b></td><td>—</td><td>Se advierte que, no es posible ingresar al nodo, personal de Pronatel indica que desde el NOC de Amazonas le informan que el nodo no tiene con exión con el NOC, motivo por el cual no es posible la apertura remota de la puerta de ingreso.</td><td>FOTOS Y VIDEO DE LA FUNCIONALIDAD DEL SISTEMA DE SEGURIDAD FISICA</td><td align="center" style="font-weight:bold;color:#d97706;">Pendiente</td></tr><tr><td><b>OCI-1327</b></td><td>—</td><td>Se evidencia, rejilla de medidor de suministro eléctrico, no cuenta con candado de seguridad.</td><td>FOTOS DE INSTALACION DE CANDADO</td><td align="center" style="font-weight:bold;color:#d97706;">Pendiente</td></tr><tr bgcolor="#f9fafb"><td><b>H1-OC-50-2276</b></td><td>—</td><td>nodo presenta riesgo de deslizamiento de terreno (lateral izquierdo).</td><td>SUSTENTO + MEMORIA DE CÁLCULO + FOTOGRAFÍAS DE SUBSANACIÓN + PLANOS ASBUILT</td><td align="center" style="font-weight:bold;color:#64748b;">Descartado</td></tr><tr><td><b>H1-OC-50-2232</b></td><td>—</td><td>falta actualizar planos asbuilt</td><td>FOTOGRAFIAS DE MEDIDAS + PLANOS ASBUILT</td><td align="center" style="font-weight:bold;color:#64748b;">Descartado</td></tr><tr bgcolor="#f9fafb"><td><b>H1-OC-50-2231</b></td><td>—</td><td>faltan planos asbuilt en obra</td><td>Fotos + Planos asbuilt</td><td align="center" style="font-weight:bold;color:#64748b;">Descartado</td></tr><tr><td><b>H1-OC-50-2245</b></td><td>—</td><td>falta colocar candados</td><td>FOTOS</td><td align="center" style="font-weight:bold;color:#64748b;">Descartado</td></tr><tr bgcolor="#f9fafb"><td><b>H1-OC-50-2230</b></td><td>—</td><td>faltan planos asbuilt se verifico con planos de obra</td><td>PLANOS ASBUILT FIRMADOS</td><td align="center" style="font-weight:bold;color:#64748b;">Descartado</td></tr><tr><td><b>H1-OC-50-2256</b></td><td>—</td><td>adjuntar sustento FOTOGRÁFICO del proceso del compactado de la cimentacion de torre donde se evidencia el uso del material indicado en el ems (material de prestamo) - sustentar.</td><td>INFORME FOTOGRÁFICO DEL PROCESO DE SUBSANACIÓN + EMS + ENSAYOS DE CALIDAD + CERTIFICADO DE CALIBRACIÓN DE EQUIPO Y/O HOMOLOGACIÓN DE LABORATORIO + PLANOS ASBUILT</td><td align="center" style="font-weight:bold;color:#64748b;">Descartado</td></tr><tr bgcolor="#f9fafb"><td><b>B-1197</b></td><td>—</td><td>Cables no identificados en caja de pase</td><td>FOTOGRAFIAS DE SUBSANACION</td><td align="center" style="font-weight:bold;color:#d97706;">Pendiente</td></tr><tr><td><b>B-1199</b></td><td>—</td><td>Pendiente identificación y peinado en caja de pase y barra de conexión en powercore</td><td>FOTOGRAFIAS DE SUBSANACION</td><td align="center" style="font-weight:bold;color:#d97706;">Pendiente</td></tr>
      </tbody>
    </table>
    
</div>]]></description>
