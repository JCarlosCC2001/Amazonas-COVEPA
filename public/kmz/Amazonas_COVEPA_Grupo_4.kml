      </thead>
      <tbody>
        <tr><td><b>H1-OC-50-2310</b></td><td>Pintado de columnas, vigas y sobrecimiento</td><td>Mejorar Pintado de columnas, vigas y sobrecimiento</td><td>FOTOS DE SUBSANACIÓN</td><td align="center" style="font-weight:bold;color:#d97706;">Pendiente</td></tr><tr bgcolor="#f9fafb"><td><b>H1-OC-50-2314</b></td><td>Sellado en juntas de fabricación</td><td>Falta sellar juntas y mejorar acabado en soldaduras en las juntas</td><td>FOTOS</td><td align="center" style="font-weight:bold;color:#d97706;">Pendiente</td></tr><tr><td><b>H1-SH-50-109</b></td><td>TODOS LOS ACCESOS DE CABLE DEBERAN ESTAR EN LA PARTE INFERIOR Y DEBERAN PERMITIR EL ADECUADO INGRESO DE CABLES Y SU RESPECTIVO SELLAMIENTO. DEBERA CON ALARMA DE PUERTA ABIERTA DE TIPO FIN DE CARRERA</td><td>Falta fin de carrera.</td><td>FOTOS DE INSTALACION Y VIDEO DE OPERATIVIDAD DE L SENSOR</td><td align="center" style="font-weight:bold;color:#d97706;">Pendiente</td></tr><tr bgcolor="#f9fafb"><td><b>C-4104</b></td><td>—</td><td>Tubo de protección es de 70 cm. Bajante del pararrayos esta sujeto con grapas</td><td>FOTO DE TUBO DE PROTECCIÓN 1.80 MTS DESDE EL SUELO / AISLADOR CERÁMICO EN CABLE</td><td align="center" style="font-weight:bold;color:#d97706;">Pendiente</td></tr><tr><td><b>C-4106</b></td><td>—</td><td>Cable acerado y conector AB, se encuentran oxidados</td><td>Informe de Subsanacion</td><td align="center" style="font-weight:bold;color:#d97706;">Pendiente</td></tr><tr bgcolor="#f9fafb"><td><b>C-4107</b></td><td>—</td><td>Etiqueta de una antena, ilegible</td><td>Fotografias de etiquetado de identificación legibles.</td><td align="center" style="font-weight:bold;color:#d97706;">Pendiente</td></tr><tr><td><b>C-4108</b></td><td>—</td><td>Cableado con etiquetado ilegible</td><td>Fotografias de etiquetado de identificación legibles.</td><td align="center" style="font-weight:bold;color:#d97706;">Pendiente</td></tr><tr bgcolor="#f9fafb"><td><b>C-4109</b></td><td>—</td><td>Banco de baterías y rectificador sin rotulados</td><td>FOTOS DE ROTULADO DE BATERÍAS Y MODULOS RECTIFICADORES</td><td align="center" style="font-weight:bold;color:#d97706;">Pendiente</td></tr><tr><td><b>C-4110</b></td><td>—</td><td>No se realizó prueba de autonomía de baterías, debido a que rectificador no cuenta con cable de gestón</td><td>Informe de Subsanacion</td><td align="center" style="font-weight:bold;color:#d97706;">Pendiente</td></tr><tr bgcolor="#f9fafb"><td><b>C-4113</b></td><td>—</td><td>No presentó plano asbuilt para verificar ubicación del sensor de puerta abierta</td><td>Fotografia de instalacion del dispositivo + planos de distribución de dispositivos de seguridad</td><td align="center" style="font-weight:bold;color:#d97706;">Pendiente</td></tr><tr><td><b>C-4114</b></td><td>—</td><td>Sensor de puerta abierta no se encuentra instalado</td><td>Fotografia de instalación y video de funcionamiento de dispositivo.</td><td align="center" style="font-weight:bold;color:#d97706;">Pendiente</td></tr><tr bgcolor="#f9fafb"><td><b>C-4115</b></td><td>—</td><td>Sensor de puerta abierta no se encuentra instalado</td><td>Fotografia de instalación y video de funcionamiento de dispositivo.</td><td align="center" style="font-weight:bold;color:#d97706;">Pendiente</td></tr><tr><td><b>C-4116</b></td><td>—</td><td>Extintor no se encuentra instalado</td><td>Fotografias de instalacion de extintor + planos de Seguridad</td><td align="center" style="font-weight:bold;color:#d97706;">Pendiente</td></tr><tr bgcolor="#f9fafb"><td><b>C-4117</b></td><td>—</td><td>Extintor no se encuentra instalado</td><td>Fotografia de Extintor instalado correctamente.</td><td align="center" style="font-weight:bold;color:#d97706;">Pendiente</td></tr><tr><td><b>C-4124</b></td><td>—</td><td>Sensor de puerta abierta no se encuentra instalado</td><td>Fotografia de instalación y video de funcionamiento donde se verifique alarma cuando se active el sensor.</td><td align="center" style="font-weight:bold;color:#d97706;">Pendiente</td></tr><tr bgcolor="#f9fafb"><td><b>C-4126</b></td><td>—</td><td>Sensor de puerta abierta no se encuentra instalado</td><td>Fotografia de instalación y video de funcionamiento donde se verifique alarma cuando se active el sensor.</td><td align="center" style="font-weight:bold;color:#d97706;">Pendiente</td></tr><tr><td><b>C-4130</b></td><td>—</td><td>Luminaria interna, no instalada</td><td>VIDEO DE OPERATIVIDAD DE LUMINARIA INTERNA DE SHELTER</td><td align="center" style="font-weight:bold;color:#d97706;">Pendiente</td></tr><tr bgcolor="#f9fafb"><td><b>C-4131</b></td><td>—</td><td>Luminaria externa, no instalada</td><td>VIDEO DE OPERATIVIDAD DE LUMINARIA EXTERNA DE SHELTER</td><td align="center" style="font-weight:bold;color:#d97706;">Pendiente</td></tr><tr><td><b>C-4134</b></td><td>—</td><td>Acometida no esta fijado al mástil y no cuenta con cuello de ganso</td><td>FOTO DE CUELLO DE GANZO INSTALADO Y SELLADO / ATERRAMIENTO DE MASTIL</td><td align="center" style="font-weight:bold;color:#d97706;">Pendiente</td></tr><tr bgcolor="#f9fafb"><td><b>C-4135</b></td><td>—</td><td>Baterias y modulos rectificadores, no cuentan con identificación</td><td>FOTOS DE ROTULADO DE BATERÍAS Y MODULOS RECTIFICADORES</td><td align="center" style="font-weight:bold;color:#d97706;">Pendiente</td></tr><tr><td><b>C-4136</b></td><td>—</td><td>Baterias y modulos rectificadores, no están rotulados</td><td>FOTO DE ROTULADO DE BATERÍAS / CABLES DE GESTIÓN / CABLES DE ENERGÍA / MODULOS RECTIFICADORES</td><td align="center" style="font-weight:bold;color:#d97706;">Pendiente</td></tr><tr bgcolor="#f9fafb"><td><b>C-4139</b></td><td>—</td><td>Circuitos no cuentan con identificación tipo banderillas</td><td>FOTO DEL CORRECTO ETIQUETADO DE LOS CIRCUITOS EN TG</td><td align="center" style="font-weight:bold;color:#d97706;">Pendiente</td></tr><tr><td><b>C-4140</b></td><td>—</td><td>Cableado, no cuenta con terminales</td><td>FOTOS DE CABLEADO CON TERMINALES EN TG</td><td align="center" style="font-weight:bold;color:#d97706;">Pendiente</td></tr><tr bgcolor="#f9fafb"><td><b>C-4142</b></td><td>—</td><td>Documentación no es propia del nodo y no cuenta con firma de especialista</td><td>FOTO DE DIAGRAMA UNIFILAR EN TG EN BUEN ESTADO FIRMADO POR ESPECIALISTA</td><td align="center" style="font-weight:bold;color:#d97706;">Pendiente</td></tr><tr><td><b>C-4145</b></td><td>—</td><td>Tapas de caja de pase no son herméticas</td><td>Informe de Subsanacion</td><td align="center" style="font-weight:bold;color:#d97706;">Pendiente</td></tr><tr bgcolor="#f9fafb"><td><b>C-4147</b></td><td>—</td><td>Pases en muro no se encuentran sellados</td><td>FOTOGRAFIAS DE SUBSANACION</td><td align="center" style="font-weight:bold;color:#d97706;">Pendiente</td></tr><tr><td><b>C-4148</b></td><td>—</td><td>Pendiente de cableado externo para tomacorriente y luminarias</td><td>Fotografias de instalación</td><td align="center" style="font-weight:bold;color:#d97706;">Pendiente</td></tr><tr bgcolor="#f9fafb"><td><b>C-4149</b></td><td>—</td><td>Tomacorrientes e interruptores externos, pendiente de instalación</td><td>Fotografias de instalación y sellado acorde.</td><td align="center" style="font-weight:bold;color:#d97706;">Pendiente</td></tr><tr><td><b>C-4150</b></td><td>—</td><td>Luminarias no instaladas</td><td>Fotografias de instalación acorde</td><td align="center" style="font-weight:bold;color:#d97706;">Pendiente</td></tr><tr bgcolor="#f9fafb"><td><b>C-4151</b></td><td>—</td><td>Luminarias no instaladas</td><td>Informe de Subsanacion</td><td align="center" style="font-weight:bold;color:#d97706;">Pendiente</td></tr><tr><td><b>C-4152</b></td><td>—</td><td>Luminarias no instaladas</td><td>Informe de Subsanacion</td><td align="center" style="font-weight:bold;color:#d97706;">Pendiente</td></tr><tr bgcolor="#f9fafb"><td><b>C-4153</b></td><td>—</td><td>Tomacorriente hidrobox no instalado</td><td>Informe de Subsanacion</td><td align="center" style="font-weight:bold;color:#d97706;">Pendiente</td></tr><tr><td><b>C-4154</b></td><td>—</td><td>Equipo de luz de emergencia, no instalado</td><td>Video de Operatividad y Datasheet</td><td align="center" style="font-weight:bold;color:#d97706;">Pendiente</td></tr><tr bgcolor="#f9fafb"><td><b>C-4155</b></td><td>—</td><td>Equipo de luz de emergencia, no instalado</td><td>Video de Operatividad y Datasheet</td><td align="center" style="font-weight:bold;color:#d97706;">Pendiente</td></tr><tr><td><b>C-4156</b></td><td>—</td><td>Tomacorriente e interruptor no instalados</td><td>Informe de Subsanacion</td><td align="center" style="font-weight:bold;color:#d97706;">Pendiente</td></tr><tr bgcolor="#f9fafb"><td><b>C-4157</b></td><td>—</td><td>Equipos de iluminación no instalados</td><td>Informe de Subsanacion</td><td align="center" style="font-weight:bold;color:#d97706;">Pendiente</td></tr><tr><td><b>C-4158</b></td><td>—</td><td>Equipo de luz de emergencia, no instalado</td><td>Video de Operatividad y Datasheet</td><td align="center" style="font-weight:bold;color:#d97706;">Pendiente</td></tr><tr bgcolor="#f9fafb"><td><b>C-4164</b></td><td>—</td><td>Barra SGB no es el indicado, según plano asbuil</td><td>Informe de Subsanacion</td><td align="center" style="font-weight:bold;color:#d97706;">Pendiente</td></tr><tr><td><b>C-4165</b></td><td>—</td><td>Cables en pozos, no cuentan con identificación</td><td>Informe de Subsanacion</td><td align="center" style="font-weight:bold;color:#d97706;">Pendiente</td></tr><tr bgcolor="#f9fafb"><td><b>C-4166</b></td><td>—</td><td>Cables de tierra en cajas de pase, no cuentan identificación</td><td>Informe de Subsanacion</td><td align="center" style="font-weight:bold;color:#d97706;">Pendiente</td></tr><tr><td><b>C-4167</b></td><td>—</td><td>Cables de tierra en barras equipotenciales,no cuentan con identificación</td><td>Informe de Subsanacion</td><td align="center" style="font-weight:bold;color:#d97706;">Pendiente</td></tr><tr bgcolor="#f9fafb"><td><b>C-4168</b></td><td>—</td><td>Mástil de la cámara PTZ, no cuenta con conexión al SPAT</td><td>Fotografia de subsanación</td><td align="center" style="font-weight:bold;color:#d97706;">Pendiente</td></tr><tr><td><b>C-4170</b></td><td>—</td><td>Cables de tierra en barras equipotenciales,no cuentan con identificación</td><td>Informe de Subsanacion</td><td align="center" style="font-weight:bold;color:#d97706;">Pendiente</td></tr><tr bgcolor="#f9fafb"><td><b>C-4173</b></td><td>—</td><td>Acometida no cuenta con cuello de ganso, cable no se encuentra fijado al mástil</td><td>FOTOGRAFÍA DE SUBSANACIÓN</td><td align="center" style="font-weight:bold;color:#d97706;">Pendiente</td></tr><tr><td><b>C-4174</b></td><td>—</td><td>Medidor no cuenta con rejilla</td><td>FOTOGRAFIA DE SUBSANACION</td><td align="center" style="font-weight:bold;color:#d97706;">Pendiente</td></tr><tr bgcolor="#f9fafb"><td><b>H1-SF-100-75</b></td><td>—</td><td>Falta instalar sensor de puerta abierta en shelter.</td><td>FOTOS DE INSTALACION Y VIDEO DE OPERATIVIDAD DE L SENSOR + PLANO ASBUILT</td><td align="center" style="font-weight:bold;color:#d97706;">Pendiente</td></tr><tr><td><b>OCI-0347</b></td><td>—</td><td>Se evidencia la falta de drenaje pluvial alrededor del nodo, murete de medidor electrico no tiene voladizo.</td><td>FOTOS DEL DRENAJE FLUVIAL ALREDEDOR DEL NODO INSTALADOS</td><td align="center" style="font-weight:bold;color:#d97706;">Pendiente</td></tr><tr bgcolor="#f9fafb"><td><b>OCI-0348</b></td><td>—</td><td>Se evidencia presencia de vegetacion dentro del nodo.</td><td>FOTO PANORAMICA DE LIMPIEZA (SIN MALEZA) EN EL NODO</td><td align="center" style="font-weight:bold;color:#d97706;">Pendiente</td></tr><tr><td><b>OCI-0351</b></td><td>—</td><td>Se evidencia pintado de base de concreto deficiente perteneciente a la torre de telecomunicaciones.</td><td>FOTOS DE SUBSANACION</td><td align="center" style="font-weight:bold;color:#d97706;">Pendiente</td></tr><tr bgcolor="#f9fafb"><td><b>OCI-0356</b></td><td>—</td><td>Se evidencia presencia de oxido ferroso en varilla de cobre. Inadecuada instalación y ajuste del prisionero, el conductor de puesta a tierra y variila de cobre.</td><td>FOTO DE VARILLA DE COBRE SIN OXIDO</td><td align="center" style="font-weight:bold;color:#d97706;">Pendiente</td></tr><tr><td><b>OCI-0353</b></td><td>—</td><td>Se evidencia que los pernos tienen espaciamiento deficiente para realizar el torque.</td><td>FOTOS DE SUBSANACION</td><td align="center" style="font-weight:bold;color:#d97706;">Pendiente</td></tr><tr bgcolor="#f9fafb"><td><b>OCI-0361</b></td><td>—</td><td>Pernos no tienen uniformidad en el torque, montaje de lamina metálica desalineada con respecto al soporte de sujeción de la torre de telecomunicaciones</td><td>FOTOS DE SUBSANACION</td><td align="center" style="font-weight:bold;color:#d97706;">Pendiente</td></tr><tr><td><b>H1-OC-50-2309</b></td><td>Pintado de muro de ladrillo, de acuerdo a proyecto</td><td>Mejorar Pintado de muro de ladrillo</td><td>FOTOS DE SUBSANACIÓN / SUSTENTO</td><td align="center" style="font-weight:bold;color:#d97706;">Pendiente</td></tr>
      </tbody>
    </table>
    
</div>]]></description>
