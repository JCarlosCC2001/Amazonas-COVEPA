        <tr><td><b>H2-IAO-50-12</b></td><td>—</td><td>Hurto de impresora</td><td>Fotografia de instalación de equipo</td><td align="center" style="font-weight:bold;color:#d97706;">Pendiente</td></tr><tr bgcolor="#f9fafb"><td><b>H2-IAO-50-13</b></td><td>—</td><td>Hurto de impresora, no se realizo prueba de impresion.</td><td>Informe de Subsanacion</td><td align="center" style="font-weight:bold;color:#d97706;">Pendiente</td></tr>
