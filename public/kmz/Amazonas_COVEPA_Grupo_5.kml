      <tbody>
        <tr><td><b>D-3114</b></td><td>—</td><td>No operativo</td><td>VIDEO DE OPERATIVIDAD</td><td align="center" style="font-weight:bold;color:#d97706;">Pendiente</td></tr><tr bgcolor="#f9fafb"><td><b>D-3115</b></td><td>—</td><td>No operativo</td><td>FOTOGRAFÍAS DE SUBSANACIÓN + VIDEO DE PRUEBA DE AUTONOMÍA + FICHA TÉCNICA + PLANOS AS BUILT</td><td align="center" style="font-weight:bold;color:#d97706;">Pendiente</td></tr><tr><td><b>D-3125</b></td><td>—</td><td>Tubo de bajante de acometida
Conexión de barras de torre</td><td>Informe de Subsanacion</td><td align="center" style="font-weight:bold;color:#d97706;">Pendiente</td></tr><tr bgcolor="#f9fafb"><td><b>D-3130</b></td><td>—</td><td>No cuenta con cable de tierra de la torre</td><td>Informe de Subsanacion</td><td align="center" style="font-weight:bold;color:#d97706;">Pendiente</td></tr><tr><td><b>H1-OC-50-2063</b></td><td>Pintura en portón</td><td>Retoque de pintura en puerta de ingreso.</td><td>FOTOS</td><td align="center" style="font-weight:bold;color:#d97706;">Pendiente</td></tr><tr bgcolor="#f9fafb"><td><b>H1-OC-50-2064</b></td><td>Sellado en juntas de fabricación</td><td>Sellado de juntas y mejorar acabado en soldadura en juntas de fabricación.</td><td>FOTOS</td><td align="center" style="font-weight:bold;color:#d97706;">Pendiente</td></tr><tr><td><b>H1-OC-50-2070</b></td><td>EPS</td><td>(10.07) Retocar pintura de protección en torre</td><td>FOTOGRAFÍAS DE SUBSANACIÓN + INFORME DE PROCEDIMIENTO</td><td align="center" style="font-weight:bold;color:#d97706;">Pendiente</td></tr><tr bgcolor="#f9fafb"><td><b>H1-SP-50-124</b></td><td>EL METODO DE MEDICION DE RESISTENCIA A TIERRA SERA EL DE CAIDA DE POTENCIAL(REFERENCIA IEEE TD.80)</td><td>falta instalar el sistema de puesta a tierra - SPAT</td><td>* FOTOGRAFÍAS Y VIDEO DEL SISTEMA DE PUESTA A TIERRA CULMINADO
