gcolor="#f9fafb"><td><b>C-3336</b></td><td>—</td><td>RFID no funciona</td><td>Informe de Subsanacion</td><td align="center" style="font-weight:bold;color:#d97706;">Pendiente</td></tr><tr><td><b>C-3337</b></td><td>—</td><td>RFID no funciona</td><td>Se presentara capturas desde Gestor desde el NOC, registro de ingreso a travéz de una tarjeta RFID autorizada + video de operatividad.</td><td align="center" style="font-weight:bold;color:#d97706;">Pendiente</td></tr><tr bgcolor="#f9fafb"><td><b>C-3338</b></td><td>—</td><td>RFID no funciona</td><td>Se presentara capturas desde Gestor desde el NOC, visualizando el registro de ingreso + video de operatividaad.</td><td align="center" style="font-weight:bold;color:#d97706;">Pendiente</td></tr><tr><td><b>C-3339</b></td><td>—</td><td>luminaria inoperativa</td><td>VIDEO DE OPERATIVIDAD DE LUMINARIA INTERNA DE SHELTER</td><td align="center" style="font-weight:bold;color:#d97706;">Pendiente</td></tr><tr bgcolor="#f9fafb"><td><b>C-3340</b></td><td>—</td><td>luminaria inoperativa</td><td>VIDEO DE OPERATIVIDAD DE LUMINARIA EXTERNA DE SHELTER</td><td align="center" style="font-weight:bold;color:#d97706;">Pendiente</td></tr><tr><td><b>C-3343</b></td><td>—</td><td>falta rotulado de baterías</td><td>FOTOS DE ROTULADO DE BATERÍAS Y MODULOS RECTIFICADORES</td><td align="center" style="font-weight:bold;color:#d97706;">Pendiente</td></tr><tr bgcolor="#f9fafb"><td><b>C-3344</b></td><td>—</td><td>falta rotulado de baterías</td><td>FOTO DE ROTULADO DE BATERÍAS / CABLES DE GESTIÓN / CABLES DE ENERGÍA / MODULOS RECTIFICADORES</td><td align="center" style="font-weight:bold;color:#d97706;">Pendiente</td></tr><tr><td><b>C-3345</b></td><td>—</td><td>No presentaron planos</td><td>* FOTOGRAFÍAS PANORÁMICAS DE LA UBICACIÓN DEL TG
* PLANO DE IEE</td><td align="center" style="font-weight:bold;color:#d97706;">Pendiente</td></tr><tr bgcolor="#f9fafb"><td><b>C-3351</b></td><td>—</td><td>Luz de emergencia descargado</td><td>Fotografia de instalación de Luz de emergencia + Video de Operatividad + Planos As built</td><td align="center" style="font-weight:bold;color:#d97706;">Pendiente</td></tr><tr><td><b>C-3352</b></td><td>—</td><td>luminarias sin funcionamiento (diferencial apagado)</td><td>Informe de Subsanacion</td><td align="center" style="font-weight:bold;color:#d97706;">Pendiente</td></tr><tr bgcolor="#f9fafb"><td><b>C-3358</b></td><td>—</td><td>Tiene cintillo bandara pero no etiqueta</td><td>FOTOS DE ETIQUETADO (ORIGEN - DESTINO) + PLANO ASBUILT</td><td align="center" style="font-weight:bold;color:#d97706;">Pendiente</td></tr><tr><td><b>H1-OC-50-2277</b></td><td>—</td><td>documentacion en obra - presentaron en forma incompleta, se debera presentar para su evaluacion en gabinete los digital desde el item b.01 al b.09</td><td>PLANOS ASBUILT + DISEÑO DE MEZCLA + CUADERNO DE OBRA + ROTURA DE PROBETAS + ROTURA DE LADRILLO + CERTIFICADO DE VERTICALIDAD DE TORRE + PROTOCOLO EPS + PROTOCOLO TORQUE + CERTIFICADO DE GALVANIZADO (CERTIFICADO DE CALIBRACION DE EQUIPOS/CERTIFICADO DE HOMOLOGACION DE LABORATORIO)</td><td align="center" style="font-weight:bold;color:#64748b;">Descartado</td></tr><tr bgcolor="#f9fafb"><td><b>C-3346</b></td><td>—</td><td>Diagrama sin firma ni nombre de nodo</td><td>FOTO DE DIAGRAMA UNIFILAR EN TG EN BUEN ESTADO FIRMADO POR ESPECIALISTA</td><td align="center" style="font-weight:bold;color:#d97706;">Pendiente</td></tr><tr><td><b>C-3348</b></td><td>—</td><td>Falta sellado</td><td>Fotografias de instalación y sellado acorde.</td><td align="center" style="font-weight:bold;color:#d97706;">Pendiente</td></tr><tr bgcolor="#f9fafb"><td><b>C-3349</b></td><td>—</td><td>Luminarias inoperativas</td><td>Fotos de instalación adecuada + Video de funcionamiento</td><td align="center" style="font-weight:bold;color:#d97706;">Pendiente</td></tr><tr><td><b>C-3350</b></td><td>—</td><td>Luminarias inoperativas</td><td>VIDEO DE OPERATIVIDAD DE LUMINARIAS ACCIONANDO EL INTERRUPTOR</td><td align="center" style="font-weight:bold;color:#d97706;">Pendiente</td></tr><tr bgcolor="#f9fafb"><td><b>H1-OC-50-2279</b></td><td>—</td><td>actualizar planos asbuilt</td><td>FOTOGRAFIAS DE MEDIDAS + PLANOS ASBUILT</td><td align="center" style="font-weight:bold;color:#64748b;">Descartado</td></tr>
