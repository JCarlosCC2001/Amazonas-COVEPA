      <tbody>
        <tr><td><b>H3-HS-100-149</b></td><td>—</td><td>Falta accesorios finales a canaletas indoor.</td><td>Instalación de canaleta y toma fotografica</td><td align="center" style="font-weight:bold;color:#d97706;">Pendiente</td></tr><tr bgcolor="#f9fafb"><td><b>H3-HS-100-150</b></td><td>—</td><td>Falta señalizacion a tapas de registro(tienen fondo blanco no cumple CNE)</td><td>Pintado de Tapas Spat, Toma fotografica</td><td align="center" style="font-weight:bold;color:#d97706;">Pendiente</td></tr><tr><td><b>H3-HS-100-151</b></td><td>—</td><td>Falta señalizacion a cableado de energia outdoor.</td><td>Fotografia de cableado marca, tipo y etiquetado de todo el cableado estructurado</td><td align="center" style="font-weight:bold;color:#d97706;">Pendiente</td></tr><tr bgcolor="#f9fafb"><td><b>H3-HS-100-152</b></td><td>—</td><td>Falta señalizacion a caja de paso de puesta a tierra.</td><td>Pintado de Tapas Spat, Toma fotografica</td><td align="center" style="font-weight:bold;color:#d97706;">Pendiente</td></tr><tr><td><b>H3-HS-100-153</b></td><td>—</td><td>Falta señalizacion de peligro en UPS y tablero.</td><td>Fotografias de Instalación y Informe de sustento.</td><td align="center" style="font-weight:bold;color:#d97706;">Pendiente</td></tr><tr bgcolor="#f9fafb"><td><b>H3-HS-100-154</b></td><td>—</td><td>Etiquetado borroso en cableado SFTP outdoor.</td><td>Etiquetado outddor AP, CPE, y evidencias fotografica</td><td align="center" style="font-weight:bold;color:#d97706;">Pendiente</td></tr><tr><td><b>H3-HS-100-155</b></td><td>—</td><td>UPS alarmado, descargado(se dejo encendido por 50&#x27; pero no cargo nada)</td><td>Video de operativiidad de 10 min de UPS, Fotos panoramicas de UPS y baterias Outdoor instalado.</td><td align="center" style="font-weight:bold;color:#d97706;">Pendiente</td></tr><tr bgcolor="#f9fafb"><td><b>H3-HS-100-156</b></td><td>—</td><td>Valor promedio de Jitter 97.10 ms supera limite permitido.</td><td>Capturas Fotos Navegación Internet, Paginas Prohibidasy Velocidad de Internet.</td><td align="center" style="font-weight:bold;color:#d97706;">Pendiente</td></tr>
